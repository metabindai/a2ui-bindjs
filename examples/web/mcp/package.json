{
    "name": "@metabindai/a2ui-bindjs-mcp",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "description": "A2UI delivered over MCP and rendered with BindJS",
    "scripts": {
        "dev": "concurrently -n server,web -c magenta,cyan \"pnpm dev:server\" \"vite\"",
        "dev:server": "tsx watch server/server.ts",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "test": "vitest run"
    },
    "dependencies": {
        "@metabindai/a2ui-bindjs": "workspace:*",
        "@metabindai/a2ui-bindjs-react": "workspace:*",
        "@metabindai/bindjs-react": "^1.0.5",
        "@metabindai/bindjs-runtime": "^1.0.9",
        "@modelcontextprotocol/sdk": "^1.30.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "styled-components": "^6.1.14",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.10.5",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.0",
        "jsdom": "^28.0.0",
        "tsx": "^4.19.2",
        "typescript": "~5.6.2",
        "vite": "^6.0.5",
        "vitest": "^3.1.1"
    }
}
