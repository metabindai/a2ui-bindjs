# Copy to `.env.local` to pull the catalog from a Metabind project.
# Without these the example still runs, using the catalog bundled in the package.
#
# The API key needs the `read:components` scope — `read:content` alone is rejected by
# `resolvedPackageData`. Mint one with:
#   metabind api-key create --data '{"name":"a2ui-example","scopes":["read:components","read:content"]}'

VITE_METABIND_ORGANIZATION_ID=
VITE_METABIND_PROJECT_ID=

# A published package id, or the project's draft package — `draft:<projectId>:<orgId>` —
# which resolves whatever is currently in the Composer, with no publish step.
VITE_METABIND_PACKAGE_ID=

# One of these. A preview token shares a build without handing out an API key.
VITE_METABIND_API_KEY=
VITE_METABIND_PREVIEW_TOKEN=

# Optional. Defaults to `/metabind-api`, which Vite proxies to the real API — the API
# sends no CORS headers, so the browser cannot call it directly. Set an absolute URL only
# if you are proxying somewhere else.
VITE_METABIND_URL=
